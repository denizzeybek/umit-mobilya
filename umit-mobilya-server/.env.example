# Bu dosyayi .env olarak kopyalayip degerleri doldurun.
# Production'da ayni degiskenler Railway dashboard'undan girilir.

PORT=3000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/umit-mobilya

# Lokal gelistirme icin alternatif:
# MONGO_URI=mongodb://localhost:27017/umit-mobilya

JWT_SECRET=<rastgele-uzun-bir-dize>

# CORS: virgulle ayrilmis izinli origin listesi.
# Netlify domain'i buraya eklenmeli, yoksa tarayici istegi reddedilir.
ALLOWED_ORIGINS=http://localhost:3001

# --- Cloudflare R2 (S3 uyumlu) ---

# R2 bucket adi
BUCKET_NAME=umit-mobilya-images

# R2 S3 API endpoint'i (Cloudflare panelinde bucket > Settings > S3 API)
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# Bucket'in public erisim adresi. Custom domain bagladiysan onu yaz,
# yoksa r2.dev alt alan adini kullan. Sondaki slash onemsiz.
PUBLIC_BUCKET_URL=https://img.ornek-alan-adi.com

# R2 API token'i (Object Read & Write yetkisi yeterli)
ACCESS_KEY=<r2-access-key-id>
SECRET_ACCESS_KEY=<r2-secret-access-key>

# --- e2e (yarn e2e:api) ---
# ZORUNLU DEGIL. `yarn e2e:api` bellek ici bir mongod baslatip kendi sahte
# kimliklerini kendi yaziyor; bu dosyayi hic okumaz (NODE_ENV=test).
# Yalnizca port cakismasinda:
# E2E_API_PORT=5055

# --- Hiz siniri ---
# TANIMLAMA. `1` hiz sinirini tamamen kapatir ve yalnizca testler icindir
# (test/create-test-app.ts kendisi yaziyor). Varsayilan "sinir acik" olmasi
# bilincli: unutulan bir degisken korumayi kaldirmamali.
# THROTTLE_SKIP=1
