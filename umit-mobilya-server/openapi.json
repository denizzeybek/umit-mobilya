  "info": {
    "title": "Ümit Mobilya API",
    "description": "Frontend istemcisi bu şemadan üretilir (`yarn gcl`). Bir uç burada görünmüyorsa istemcide de yoktur.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "SignupDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Login address. Stored lowercased and unique across users.",
            "format": "email"
          },
          "password": {
            "type": "string",
            "description": "Plain password, at least six characters. Never stored as given.",
            "minLength": 6
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "type": "string",
            "description": "The signed-in user's id, as a bare hex string — not an object."
          },
          "token": {
            "type": "string",
            "description": "Signed JWT, valid for three days. Also set as an httpOnly `jwt` cookie on\nthe same response; the frontend stores this copy in localStorage."
          }
        },
        "required": [
          "user",
          "token"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Registered login address.",
            "format": "email"
          },
          "password": {
            "type": "string",
            "description": "Plain password, compared against the stored bcrypt hash."
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "MessageResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Human-readable confirmation, safe to show to the user as-is."
          }
        },
        "required": [
          "message"
        ]
      },
      "PublicUserDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "description": "Login address, always lowercased. The password hash is never included."
          }
        },
        "required": [
          "_id",
          "email"
        ]
      },
      "MeResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Always \"Token is valid\". Kept because the frontend store reads the envelope."
          },
          "user": {
            "$ref": "#/components/schemas/PublicUserDto"
          }
        },
        "required": [
          "message",
          "user"
        ]
      },
      "CategoryResponseDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "description": "Mongo id, as a hex string."
          },
          "name": {
            "type": "string",
            "description": "Display name shown in the category list."
          },
          "createdAt": {
            "type": "string",
            "description": "ISO-8601 timestamp of when the category was added."
          }
        },
        "required": [
          "_id",
          "name",
          "createdAt"
        ]
      },
      "FilterCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Case-insensitive substring to match against the category name. Omit it to\nget every category back.",
            "maxLength": 120
          }
        }
      },
      "CreateCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Display name shown in the category list, e.g. \"Koltuk Takımı\".",
            "maxLength": 120
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "New display name for the category.",
            "maxLength": 120
          }
        },
        "required": [
          "name"
        ]
      },
      "ProductResponseDto": {
        "type": "object",
        "properties": {
          "imageUrlList": {
            "type": "array",
            "items": {
              "type": "string",
              "nullable": true
            },
            "description": "Public URLs matching `imageNameList`, position for position."
          },
          "configuratorPreset": {
            "type": "object",
            "additionalProperties": true,
            "description": "Konfigüratör başlangıç noktası: `{ productType, config }`. Arayüz bunu\nURL'e kodlayıp \"benzerini kendi ölçünle kur\" bağlantısını kuruyor;\nportfolyoyu vitrin olmaktan çıkarıp huniye çeviriyor."
          },
