            "bearer": []
          }
        ],
        "summary": "Appends gallery images.\n\nThe field name is the **singular** `image` even though several files are\naccepted — inherited from `upload.array('image', 20)`, and the frontend\nappends every file under that one key.",
        "tags": [
          "products"
        ]
      }
    },
