    "/api/products": {
      "get": {
        "operationId": "ProductController_findAll",
        "parameters": [],
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProductResponseDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Every product, in the read shape: modules flattened, image URLs composed,\ntotalPrice added.\n\nAnswers **201**, not 200. That is what the Express version did and the\nfrontend has been living with it; changing it is a separate decision.",
        "tags": [
          "products"
        ]
      },
      "post": {
        "operationId": "ProductController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/CreateProductBodyDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductDocumentDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Adds a product. The image is required and is uploaded to R2.",
        "tags": [
          "products"
        ]
      }
    },
    "/api/products/filter": {
      "post": {
        "operationId": "ProductController_filter",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
