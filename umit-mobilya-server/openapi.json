              "schema": {
                "$ref": "#/components/schemas/FilterProductDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProductResponseDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Filters products by name and category.\n\nA POST that performs a read, and public — both inherited from the Express\nversion, which the frontend's product list depends on.",
        "tags": [
          "products"
        ]
      }
    },
    "/api/products/create-images/{id}": {
