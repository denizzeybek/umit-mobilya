  },
  "info": {
    "title": "Ümit Mobilya API",
    "description": "Frontend istemcisi bu şemadan üretilir (`yarn gcl`). Bir uç burada görünmüyorsa istemcide de yoktur.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "SignupDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Login address. Stored lowercased and unique across users.",
            "format": "email"
          },
          "password": {
            "type": "string",
            "description": "Plain password, at least six characters. Never stored as given.",
            "minLength": 6
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "type": "string",
            "description": "The signed-in user's id, as a bare hex string — not an object."
          },
          "token": {
            "type": "string",
            "description": "Signed JWT, valid for three days. Also set as an httpOnly `jwt` cookie on\nthe same response; the frontend stores this copy in localStorage."
          }
        },
        "required": [
          "user",
          "token"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Registered login address.",
            "format": "email"
          },
          "password": {
            "type": "string",
            "description": "Plain password, compared against the stored bcrypt hash."
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "MessageResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Human-readable confirmation, safe to show to the user as-is."
          }
        },
        "required": [
          "message"
        ]
      },
      "PublicUserDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "description": "Login address, always lowercased. The password hash is never included."
          }
        },
        "required": [
          "_id",
          "email"
        ]
      },
      "MeResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Always \"Token is valid\". Kept because the frontend store reads the envelope."
          },
          "user": {
            "$ref": "#/components/schemas/PublicUserDto"
          }
        },
        "required": [
          "message",
          "user"
        ]
      },
      "CategoryResponseDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "description": "Mongo id, as a hex string."
          },
          "name": {
            "type": "string",
            "description": "Display name shown in the category list."
          },
          "createdAt": {
            "type": "string",
            "description": "ISO-8601 timestamp of when the category was added."
          }
        },
        "required": [
          "_id",
          "name",
          "createdAt"
        ]
      },
      "FilterCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Case-insensitive substring to match against the category name. Omit it to\nget every category back.",
            "maxLength": 120
          }
        }
      },
      "CreateCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Display name shown in the category list, e.g. \"Koltuk Takımı\".",
            "maxLength": 120
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "New display name for the category.",
            "maxLength": 120
          }
        },
        "required": [
          "name"
        ]
      },
      "ProductModuleResponseDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "imageUrl": {
            "type": "string",
            "nullable": true,
            "description": "Permanent public R2 URL, or null when that product has no image."
          },
          "quantity": {
            "type": "number",
            "description": "How many of this module the parent product contains."
          },
          "sizes": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "$ref": "#/components/schemas/CategoryResponseDto"
          }
        },
        "required": [
          "_id",
          "name",
          "price",
          "currency",
          "imageUrl",
          "quantity"
        ]
      },
      "ProductResponseDto": {
        "type": "object",
        "properties": {
          "imageUrlList": {
            "type": "array",
            "items": {
              "type": "string",
              "nullable": true
            },
            "description": "Public URLs matching `imageNameList`, position for position."
          },
          "_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "description": "Base price, before modules are added."
          },
          "currency": {
            "type": "string"
          },
          "imageName": {
            "type": "string",
            "description": "R2 object key of the main image. Never send this back as a URL."
          },
          "imageUrl": {
            "type": "string",
            "nullable": true,
            "description": "Permanent public R2 URL composed from `imageName`, or null when unset."
          },
          "imageNameList": {
            "description": "R2 object keys of the gallery images.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sizes": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "$ref": "#/components/schemas/CategoryResponseDto"
          },
          "quantity": {
            "type": "number"
          },
          "modules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductModuleResponseDto"
            }
          },
          "totalPrice": {
            "type": "number",
            "description": "`price` plus, for every module, its price times its quantity."
          }
        },
        "required": [
          "imageUrlList",
          "_id",
          "name",
          "price",
          "currency",
          "imageUrl",
          "imageNameList",
          "quantity",
          "modules",
          "totalPrice"
        ]
      },
      "FilterProductDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Case-insensitive substring matched against the product name.",
            "maxLength": 200
          },
          "category": {
            "type": "string",
            "description": "Category id to restrict the result to."
          }
        }
      },
      "CreateProductBodyDto": {
        "type": "object",
        "properties": {
          "image": {
            "type": "string",
            "format": "binary",
            "description": "Main product image. Resized to fit 900x600 before upload."
          },
          "name": {
            "type": "string",
            "description": "Display name in the catalogue.",
            "maxLength": 200
          },
          "price": {
            "type": "number",
            "description": "Base price, before modules are added.",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "description": "ISO currency code. Defaults to TRY when omitted.",
            "maxLength": 8
          },
          "sizes": {
            "type": "string",
            "description": "Free-text dimensions, e.g. \"200x90x75\".",
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 4000
          },
          "category": {
            "type": "string",
            "description": "Id of an existing category. The request is rejected if it does not exist."
          },
          "quantity": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "image",
          "name",
          "price",
          "category"
        ]
      },
      "StoredModuleDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "description": "Id of the product used as a module."
          },
          "quantity": {
            "type": "number"
          }
        },
        "required": [
          "productId",
          "quantity"
        ]
      },
      "ProductDocumentDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "imageName": {
            "type": "string"
          },
          "imageNameList": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sizes": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "description": "Category id. Not populated on the write path."
          },
          "quantity": {
            "type": "number"
          },
          "modules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StoredModuleDto"
            }
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "_id",
          "name",
          "price",
          "currency",
          "imageNameList",
          "quantity",
          "modules",
          "createdAt"
        ]
      },
      "UploadImagesDto": {
        "type": "object",
        "properties": {
          "image": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "binary"
            },
            "description": "One or more gallery images, all under the field name `image`."
          }
        },
        "required": [
          "image"
        ]
      },
      "ImageListResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "imageNameList": {
            "description": "The product's full gallery key list after the upload, not just the new keys.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "message",
          "imageNameList"
        ]
      },
      "ModuleEntryDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "description": "Id of the product being used as a module."
          },
          "quantity": {
            "type": "number",
            "description": "How many of that product this bundle contains.",
            "minimum": 1
          }
        },
        "required": [
          "productId",
          "quantity"
        ]
      },
      "UpdateModulesDto": {
        "type": "object",
        "properties": {
          "modules": {
            "description": "The complete new module list. Replaces whatever was stored.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModuleEntryDto"
            }
          }
        },
        "required": [
          "modules"
        ]
      },
      "ProductEnvelopeDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "product": {
            "$ref": "#/components/schemas/ProductDocumentDto"
          }
        },
        "required": [
          "message",
          "product"
        ]
      },
      "AddModuleDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "description": "Id of the product the module is added to."
          },
          "module": {
            "description": "The module to add.",
            "allOf": [
              {
                "$ref": "#/components/schemas/ModuleEntryDto"
              }
            ]
          }
        },
        "required": [
          "productId",
          "module"
        ]
      },
      "DeleteImageDto": {
        "type": "object",
        "properties": {
          "imageName": {
            "type": "string",
            "description": "R2 object key of the gallery image to remove — a key, never a URL."
          }
        },
        "required": [
          "imageName"
        ]
      },
      "UpdateProductDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "price": {
            "type": "number",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "maxLength": 8
          },
          "sizes": {
            "type": "string",
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 4000
          },
          "category": {
            "type": "string"
          },
          "quantity": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}
