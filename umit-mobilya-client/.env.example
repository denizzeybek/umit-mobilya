# Bu dosyayi .env olarak kopyalayip degerleri doldurun.
# Production'da ayni degiskenler Netlify dashboard'undan girilir
# (Site settings > Environment variables). Repo'dan okunmaz.

# Backend adresi. Sonunda /api olmali.
VITE_API_URL=http://localhost:3000/api

# Production ornegi:
# VITE_API_URL=https://<railway-servis-adi>.up.railway.app/api

VITE_I18N_LOCALE=tr

# --- e2e (Playwright) ---
# Hicbiri ZORUNLU DEGIL: hepsinin varsayilani e2e/config.ts icinde ve koşum
# kendi sunucularini kendi kaldiriyor. Yalnizca port cakismasinda degistir.
#
# e2e vite portu (gelistiricinin 3001'ine dokunmasin diye ayri)
# E2E_WEB_PORT=3101
# e2e API portu — hermetik Nest + mongodb-memory-server
# E2E_API_PORT=5055
# e2e yonetici hesabi (e2e-api.ts acilista bu hesabi yaratir)
# E2E_ADMIN_EMAIL=e2e@umit.test
# E2E_ADMIN_PASSWORD=e2e-parola
