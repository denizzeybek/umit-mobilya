# Bu dosyayi .env olarak kopyalayip degerleri doldurun.
# Production'da ayni degiskenler Netlify dashboard'undan girilir
# (Site settings > Environment variables). Repo'dan okunmaz.

# Backend adresi. Sonunda /api olmali.
VITE_API_URL=http://localhost:3000/api

# Production ornegi:
# VITE_API_URL=https://<railway-servis-adi>.up.railway.app/api

VITE_I18N_LOCALE=tr
