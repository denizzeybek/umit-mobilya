{
  "name": "umit-mobilya-client",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite --port 3001",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:unit:run": "vitest run",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/",
    "generate-icon-names": "node ./scripts/iconNameGenerator.js",
    "gcl": "openapi --input ../umit-mobilya-server/openapi.json --output ./src/client --client axios",
    "gcl:live": "openapi --input http://localhost:3000/docs-json --output ./src/client --client axios",
    "size-check": "node scripts/size-check.mjs",
    "e2e:smoke": "playwright test --config playwright.smoke.config.ts",
    "e2e:journeys": "playwright test --config playwright.journeys.config.ts",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@primevue/themes": "^4.2.0",
    "@vee-validate/yup": "^4.14.3",
    "@vueuse/core": "^11.2.0",
    "axios": "^1.19.0",
    "chart.js": "^4.4.6",
    "click-outside-vue3": "^4.0.1",
    "dayjs": "^1.11.13",
    "file-saver": "^2.0.5",
    "pinia": "^2.2.4",
    "primeicons": "^7.0.0",
    "primevue": "^4.2.0",
    "three": "^0.160.1",
    "vee-validate": "^4.14.3",
    "vue": "^3.5.10",
    "vue-i18n": "^10.0.8",
    "vue-router": "^4.4.5",
    "vue-toastification": "^2.0.0-rc.5",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@primevue/auto-import-resolver": "^4.2.0",
    "@rushstack/eslint-patch": "^1.10.4",
    "@tsconfig/node18": "^18.2.4",
    "@types/file-saver": "^2.0.7",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.7.7",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vitejs/plugin-vue-jsx": "^4.0.1",
    "@vue/eslint-config-prettier": "^10.0.0",
    "@vue/eslint-config-typescript": "^14.1.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.5.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-vue": "^9.29.0",
    "jsdom": "^25.0.1",
    "npm-run-all": "^4.1.5",
    "openapi-typescript-codegen": "^0.31.0",
    "postcss": "^8.5.26",
    "prettier": "^3.3.3",
    "sass": "^1.102.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.5.3",
    "unplugin-vue-components": "^0.27.4",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.1.6"
  }
}
